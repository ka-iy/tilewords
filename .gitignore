.aidlc

# Generated GADDAG dictionary assets
*.bin
*.gob
*.bin.gz

# Claude's Test data
testdata/

# Standard Go build artifacts
*.exe
*.test
*.out
vendor/

# OS artifacts
.DS_Store
Thumbs.db

# gograph
.gograph/

# editor/IDE temp files. The undo-history pattern is dotted separately: vim writes it as
# .<name>.un~, which the leading dot keeps out of reach of *~.
*~
.*.un~
.*.swp
.*.swo
.idea/

# binaries. Each is anchored with a leading slash so it matches only the compiled
# artifact at the repo root: unanchored, 'buildgaddag' also matches the tools/buildgaddag/
# source directory and silently keeps the tool out of the repo.
*.apk
*.apk.idsig
/buildgaddag
/tilewords*

# raw definition sources fetched on demand by `make defs` (see
# defs/assets/definitions/SOURCES.md). Large third-party data, not ours to redistribute
# here; the committed wordlists/*.txt are unaffected.
/wordlists/kaikki-en.jsonl
/wordlists/webster1913.json
/wordlists/wordnet/

# generated definitions asset. Not committed: F-Droid does not accept a prebuilt binary
# asset in a source tree. Every build target produces it when it is missing (see the
# defs-asset guard in the Makefile), and 'make defs' regenerates one that exists.
/defs/assets/definitions/definitions.bin.gz

# partially downloaded definitions sources, moved into place only once complete
*.part
*.stage*

# signing keystores (never commit signing keys)
*.keystore
*.jks

# .claude dir and CLAUDE.md - let users use their own customizations
.claude
CLAUDE.md

# Gurgle Signing key verification f*ckery.
# You'll need the file below if you're trying to register your own app from
# these sources, BUT since this will contain your specific developer code,
# it needs to be gitignored so it doesn't get committed.
/cmd/tilewords/assets/adi-registration.properties
